}

function applyFilters() {
  const regionValue = document.getElementById("regionFilter")?.value || "";
  const searchValue = document.getElementById("countrySearch")?.value || "";
  const minSynergy = stableNumber(document.getElementById("minSynergy")?.value || 0);

  const minSynergyValue = document.getElementById("minSynergyValue");
  if (minSynergyValue) minSynergyValue.textContent = String(minSynergy);

  const allRows = stablePlottableRows(state.scores || []);
  const hasSearch = stableNormalise(searchValue).length > 0;
  const hasRegionFilter = !stableIsAllRegion(regionValue);
  const hasSynergyFilter = minSynergy > 0;

  let rows;

  if (hasSearch) {
    rows = allRows.filter(row => stableCountryMatches(row, searchValue));
  } else {
    rows = allRows.filter(row => {
      const regionOk = !hasRegionFilter || row.region === regionValue;
      const synergyOk = !hasSynergyFilter || stableNumber(row.overall_synergy) >= minSynergy;
      return regionOk && synergyOk;
    });
  }

  if (!rows.length && !hasSearch && !hasRegionFilter && !hasSynergyFilter && allRows.length) {
    rows = allRows;
  }

  state.filtered = rows;
  stableUpdateSummary(rows);
  renderPlot();

  if (hasSearch) {
    const match = stableBestCountryMatch(rows, searchValue);
    if (match) stableSelectCountry(match);
  } else if (state.selectedRow && !rows.some(row => row.code === state.selectedRow.code)) {
    state.selectedRow = null;
    if (typeof renderTransitionLean === "function") renderTransitionLean(null);
