}

function renderPlot() {
  const plotTarget = document.getElementById("plot");
  if (!plotTarget) return;

  const rows = stablePlottableRows(state.filtered && state.filtered.length ? state.filtered : []);
  const allRows = stablePlottableRows(state.scores || []);

  if (!rows.length) {
    plotTarget.innerHTML = `
      <div class="warning-box">
        No countries match the current filters. Clear the search or choose “All regions”.
      </div>
    `;
    return;
  }

  const colourMode = document.getElementById("colourMode")?.value || "archetype";
  const ranges = stablePlotRanges(rows);
  const groups = stableGroupRows(rows, colourMode);

  const traces = [];
  let groupIndex = 0;

  for (const [groupName, groupRows] of groups.entries()) {
    const colour = stablePaletteValue(groupName, groupIndex);

    traces.push({
      type: "scatter3d",
      mode: "markers",
      name: groupName,
      x: groupRows.map(row => stableNumber(row.individual_intelligence)),
      y: groupRows.map(row => stableNumber(row.collective_intelligence)),
      z: groupRows.map(row => stableNumber(row.planetary_intelligence)),
      text: groupRows.map(row => row.country),
      customdata: groupRows.map(row => row.code),
      hovertemplate: groupRows.map(row => stableHoverTemplate(row)),
      marker: {
        size: groupRows.map(row => Math.max(6, stableNumber(row.overall_synergy) / 9)),
        color: colourMode === "synergy"
          ? groupRows.map(row => stableNumber(row.overall_synergy))
          : colour,
        colorscale: colourMode === "synergy" ? "Viridis" : undefined,
        showscale: colourMode === "synergy",
        opacity: 0.9,
        line: {
          width: 0.8,
          color: "rgba(255,255,255,0.38)"
        }
      }
    });

    groupIndex += 1;
  }

  const selected = state.selectedRow && rows.find(row => row.code === state.selectedRow.code);
  if (selected && typeof makeSelectedLocatorTrace === "function") {
    const locator = makeSelectedLocatorTrace(selected);
    if (locator) traces.push(locator);
  }

  if (document.getElementById("showLandingBars")?.checked && typeof makeDropLineTrace === "function") {
    traces.push(makeDropLineTrace(rows));
  }

  if (document.getElementById("showMaturityHalos")?.checked && typeof makeMaturityHaloTrace === "function") {
    traces.unshift(makeMaturityHaloTrace(rows));
  }

  const layout = {
    paper_bgcolor: "rgba(0,0,0,0)",
    plot_bgcolor: "rgba(0,0,0,0)",
    margin: { l: 0, r: 0, t: 10, b: 0 },
    showlegend: true,
    legend: {
      orientation: "h",
      x: 0,
      y: 1.04,
      font: { color: "#e5eefc", size: 12 },
      bgcolor: "rgba(0,0,0,0)"
    },
    scene: {
      bgcolor: "rgba(0,0,0,0)",
      camera: state.camera || { eye: { x: 1.55, y: 1.45, z: 1.2 } },
      xaxis: {
        title: "Individual intelligence",
        range: ranges.x,
        gridcolor: "rgba(153, 177, 255, 0.45)",
        zerolinecolor: "rgba(153, 177, 255, 0.22)",
        color: "#e5eefc"
      },
      yaxis: {
        title: "Collective intelligence",
        range: ranges.y,
        gridcolor: "rgba(153, 177, 255, 0.45)",
        zerolinecolor: "rgba(153, 177, 255, 0.22)",
        color: "#e5eefc"
      },
      zaxis: {
        title: "Planetary intelligence",
        range: ranges.z,
        gridcolor: "rgba(153, 177, 255, 0.45)",
        zerolinecolor: "rgba(153, 177, 255, 0.22)",
        color: "#e5eefc"
      }
    }
  };

  const config = {
    responsive: true,
    displaylogo: false
  };

  Plotly.react(plotTarget, traces, layout, config).then(() => {
    plotTarget.removeAllListeners?.("plotly_click");
    plotTarget.on?.("plotly_click", event => {
      const point = event?.points?.[0];
      const code = point?.customdata;
      if (!code) return;

      const row = allRows.find(item => item.code === code);
      if (row) stableSelectCountry(row);
    });

    plotTarget.removeAllListeners?.("plotly_relayout");
    plotTarget.on?.("plotly_relayout", event => {
      if (event && event["scene.camera"]) {
        state.camera = event["scene.camera"];
      }
    });
  });
}

