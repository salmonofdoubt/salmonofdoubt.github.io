function applyFilters() {
  const regionValue = document.getElementById("regionFilter")?.value || "";
  const searchValue = document.getElementById("countrySearch")?.value || "";
  const minSynergy = Number(document.getElementById("minSynergy")?.value || 0);
  const minSynergyValue = document.getElementById("minSynergyValue");

  if (minSynergyValue) minSynergyValue.textContent = String(minSynergy);

  const allRows = (state.scores || [])
    .map(row => typeof enrichTheoryFields === "function" ? enrichTheoryFields(row) : row)
    .filter(row =>
      row &&
      Number.isFinite(Number(row.individual_intelligence)) &&
      Number.isFinite(Number(row.collective_intelligence)) &&
      Number.isFinite(Number(row.planetary_intelligence))
    );

  const hasSearch = normaliseCountryQuery(searchValue).length > 0;
  const hasRegionFilter = !isAllRegionValue(regionValue);
  const hasSynergyFilter = Number.isFinite(minSynergy) && minSynergy > 0;

  let rows = [];

  if (hasSearch) {
    rows = allRows.filter(row => countryMatchesSearch(row, searchValue));
  } else {
    rows = allRows.filter(row => {
      const regionOk = !hasRegionFilter || row.region === regionValue;
      const synergyOk = !hasSynergyFilter || Number(row.overall_synergy || 0) >= minSynergy;
      return regionOk && synergyOk;
    });
  }

  if (!rows.length && !hasSearch && !hasRegionFilter && !hasSynergyFilter && allRows.length) {
    console.warn("Filter fail-safe restored all rows because no active filter should have produced zero rows.");
    rows = allRows;
  }

  state.filtered = rows;
  updateExplorerSummaryFromFilteredRows(rows);

  if (typeof renderPlot === "function") renderPlot();

  if (hasSearch) {
    const match = bestCountrySearchMatch(rows, searchValue);
    if (match) selectCountryFromSearch(match);
  } else if (state.selectedRow && !rows.some(row => row.code === state.selectedRow.code)) {
    state.selectedRow = null;
    if (typeof renderTransitionLean === "function") renderTransitionLean(null);
    if (typeof updateBottomReportDownloadCta === "function") updateBottomReportDownloadCta();
  }
}

/* -------------------------------------------------------------------------
   STABLE EXPLORER OVERRIDE v1
   Purpose:
   - Make filters predictable.
   - Make country search behave as lookup, not as an AND-filter.
   - Make the 3D plot derive traces and axis ranges from the same filtered rows.
   - Prevent empty-looking regional plots such as North America.
   ------------------------------------------------------------------------- */

function stableNumber(value, fallback = 0) {
  const n = Number(value);
  return Number.isFinite(n) ? n : fallback;
}

function stableClamp(value, min = 0, max = 100) {
  return Math.max(min, Math.min(max, stableNumber(value)));
}

function stableNormalise(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function stableIsAllRegion(value) {
  const v = stableNormalise(value);
  return !v || v === "all" || v === "all regions" || v === "any" || v === "*";
}

function stableCountryAliases(row) {
  const aliases = new Set([
    stableNormalise(row.country),
    stableNormalise(row.code),
    stableNormalise(row.iso3)
  ]);

  if (row.code === "US" || row.iso3 === "USA" || /united states/i.test(row.country || "")) {
    [
      "usa",
      "us",
      "u s",
      "u s a",
      "america",
      "united states",
      "united states of america"
    ].forEach(v => aliases.add(stableNormalise(v)));
  }

  if (row.code === "GB" || row.iso3 === "GBR" || /united kingdom/i.test(row.country || "")) {
    [
      "uk",
      "u k",
      "britain",
      "great britain",
      "united kingdom",
      "england"
    ].forEach(v => aliases.add(stableNormalise(v)));
  }

  if (row.code === "KR" || row.iso3 === "KOR" || /korea/i.test(row.country || "")) {
    [
      "korea",
      "south korea",
      "republic of korea",
      "korea rep"
    ].forEach(v => aliases.add(stableNormalise(v)));
  }

  return Array.from(aliases).filter(Boolean);
}

function stableCountryMatches(row, query) {
  const q = stableNormalise(query);
  if (!q) return true;

  return stableCountryAliases(row).some(alias =>
    alias === q || alias.startsWith(q) || alias.includes(q) || q.includes(alias)
  );
}

function stableBestCountryMatch(rows, query) {
  const q = stableNormalise(query);
  if (!q) return null;

  return rows.find(row => stableCountryAliases(row).some(alias => alias === q)) ||
    rows.find(row => stableCountryAliases(row).some(alias => alias.startsWith(q))) ||
    rows.find(row => stableCountryMatches(row, q)) ||
    null;
}

function stablePlottableRows(rows) {
  return (Array.isArray(rows) ? rows : [])
    .map(row => typeof enrichTheoryFields === "function" ? enrichTheoryFields(row) : row)
    .filter(row =>
      row &&
      Number.isFinite(Number(row.individual_intelligence)) &&
      Number.isFinite(Number(row.collective_intelligence)) &&
      Number.isFinite(Number(row.planetary_intelligence))
    );
}

function stableAxisRange(rows, key) {
  const values = stablePlottableRows(rows)
    .map(row => Number(row[key]))
    .filter(Number.isFinite);

  if (!values.length) return [0, 100];

  const minValue = Math.min(...values);
  const maxValue = Math.max(...values);
  const spread = Math.max(1, maxValue - minValue);
  const pad = Math.max(4, spread * 0.22);

  let low = Math.floor(Math.max(0, minValue - pad) / 5) * 5;
  let high = Math.ceil(Math.min(100, maxValue + pad) / 5) * 5;

  const minSpan = 20;
  if (high - low < minSpan) {
    const mid = (low + high) / 2;
    low = Math.floor(Math.max(0, mid - minSpan / 2) / 5) * 5;
    high = Math.ceil(Math.min(100, mid + minSpan / 2) / 5) * 5;
  }

  if (high <= low) return [0, 100];

  return [low, high];
}

function stablePlotRanges(rows) {
  return {
    x: stableAxisRange(rows, "individual_intelligence"),
    y: stableAxisRange(rows, "collective_intelligence"),
    z: stableAxisRange(rows, "planetary_intelligence")
  };
}

function stablePaletteValue(key, index = 0) {
  const palette = [
    "#38bdf8",
    "#f97316",
    "#22c55e",
    "#ef4444",
    "#a78bfa",
    "#f59e0b",
    "#14b8a6",
    "#e879f9",
    "#94a3b8"
  ];

  const fixed = {
    "High integration": "#38bdf8",
    "Individual-rich, coordination-limited": "#f97316",
    "Institutionally strong, planetary lag": "#22c55e",
    "Planet-aware, governance-limited": "#8b5cf6",
    "Low composite capacity": "#ef4444",
    "Mixed transition": "#a78bfa",
    "Europe": "#ef4444",
    "North America": "#a78bfa",
    "South America": "#22c55e",
    "Asia": "#f97316",
    "Africa": "#f59e0b",
    "Oceania": "#8d6e63"
  };

  return fixed[key] || palette[index % palette.length];
}

function stableGroupRows(rows, colourMode) {
  const groups = new Map();

  rows.forEach(row => {
    let key;
    if (colourMode === "region") {
      key = row.region || "Unknown region";
    } else if (colourMode === "synergy") {
      key = "Overall synergy";
    } else {
      key = row.archetype || "Unclassified";
    }

    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(row);
  });

  return groups;
}

function stableHoverTemplate(row) {
  return [
    `<b>${row.country}</b>`,
    `Individual: ${stableNumber(row.individual_intelligence).toFixed(1)}`,
    `Collective: ${stableNumber(row.collective_intelligence).toFixed(1)}`,
