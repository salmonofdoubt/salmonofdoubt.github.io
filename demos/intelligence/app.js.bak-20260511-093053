/* Robust country-search and filter override.
   Search behaves as country lookup, not as an AND filter with region.
   Empty/all region states always mean no region restriction. */

function normaliseCountryQuery(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function isAllRegionValue(value) {
  const v = normaliseCountryQuery(value);
  return !v || v === "all" || v === "all regions" || v === "any" || v === "*";
}

function countrySearchAliases(row) {
  const aliases = new Set([
    normaliseCountryQuery(row.country || ""),
    normaliseCountryQuery(row.code || ""),
    normaliseCountryQuery(row.iso3 || "")
  ]);

  if (row.code === "US" || row.iso3 === "USA" || /united states/i.test(row.country || "")) {
    [
      "usa",
      "us",
      "u s",
      "u s a",
      "america",
      "united states",
      "united states of america"
    ].forEach(v => aliases.add(normaliseCountryQuery(v)));
  }

  if (row.code === "GB" || row.iso3 === "GBR" || /united kingdom/i.test(row.country || "")) {
    [
      "uk",
      "u k",
      "britain",
      "great britain",
      "united kingdom",
      "england"
    ].forEach(v => aliases.add(normaliseCountryQuery(v)));
  }

  if (row.code === "KR" || row.iso3 === "KOR" || /korea/i.test(row.country || "")) {
    [
      "korea",
      "south korea",
      "republic of korea",
      "korea rep"
    ].forEach(v => aliases.add(normaliseCountryQuery(v)));
  }

  return Array.from(aliases).filter(Boolean);
}

function countryMatchesSearch(row, query) {
  const q = normaliseCountryQuery(query);
  if (!q) return true;

  return countrySearchAliases(row).some(alias =>
    alias === q || alias.includes(q) || q.includes(alias)
  );
}

function bestCountrySearchMatch(rows, query) {
  const q = normaliseCountryQuery(query);
  if (!q) return null;

  return rows.find(row => countrySearchAliases(row).some(alias => alias === q)) ||
    rows.find(row => countrySearchAliases(row).some(alias => alias.startsWith(q))) ||
    rows.find(row => countryMatchesSearch(row, q)) ||
    null;
}

function updateExplorerSummaryFromFilteredRows(rows) {
  const safeRows = Array.isArray(rows) ? rows : [];

  const setText = (id, value) => {
